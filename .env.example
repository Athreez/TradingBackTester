# Copy to `.env` (git-ignored) and fill in: the one settings file for the downloader, backtester and bots.
# NEVER commit the real .env. Paste values right after `=`, no quotes.

# ---- INDmoney login: TOTP auto-login, tokens are generated on demand and cached in .secrets/ ----
# Client ID from the indstocks.com Access Tokens page.
INDMONEY_CLIENT_ID=
# Your INDstocks MPIN.
INDMONEY_MPIN=
# The base32 KEY shown once during TOTP setup (the text behind the QR code), not the 6-digit code.
INDMONEY_TOTP_SECRET=

# ---- Paper bot (python -m paper_trader.runner) ----
STRATEGY=vix_iron_fly
CAPITAL=225000
# mirror = also send every order to INDmoney for real. Only for an EMPTY account: nothing is sent if
# INDmoney reports more than LIVE_MAX_BALANCE rupees available. Needs this PC's static IP registered.
LIVE_ORDERS=off
LIVE_MAX_BALANCE=100

# ---- Live bot, REAL MONEY (python -m live_trader.runner) ----
# Must be exactly `yes` or the live bot refuses to start. Uses STRATEGY / CAPITAL above.
LIVE_TRADING_ENABLED=no
# Most lots in any single order (anything bigger is refused).
LIVE_MAX_LOTS=1
# Entry orders allowed per day: the iron fly places 4 (2 hedges, 2 shorts). Stops, exits and retries
# don't count and are never blocked; a 5th entry (a bug re-entering) is refused.
LIVE_MAX_ENTRY_ORDERS=4

# ---- Telegram (optional): token from @BotFather, chat ids from `python -m paper_trader.notify chat-id` ----
TELEGRAM_BOT_TOKEN=
# Whitelist, as an array: every chat listed gets the bot's messages and may send it commands (incl. /exitnow).
# A message from any other chat gets no reply; its id is logged once ("ignored Telegram message from chat ...").
TELEGRAM_CHAT_IDS=[]

# ---- Offline alarm (optional): ping URL of a healthchecks.io check (see paper_trader/heartbeat.py) ----
# healthchecks.io alerts (e.g. on Telegram) when the bot stops pinging during market hours.
HEALTHCHECK_URL=

LOG_LEVEL=INFO
