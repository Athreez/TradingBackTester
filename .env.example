# Copy to `.env` (git-ignored) and fill in. NEVER commit the real .env.
# Shared credentials used by the data downloader, backtester and bots.
# Paste values right after `=`, no quotes, no spaces.

# ---------------- INDmoney / INDstocks (market data, paper trading quotes) ----------------
# Preferred: TOTP auto-login. Tokens are generated on demand and cached in .secrets/.
# Client ID: shown on the indstocks.com Access Tokens page after TOTP setup.
INDMONEY_CLIENT_ID=
# Your INDstocks MPIN.
INDMONEY_MPIN=
# The base32 KEY shown once during TOTP setup (the text behind the QR code), NOT the 6-digit code.
INDMONEY_TOTP_SECRET=
# Fallback only when the three above are empty: a dashboard token (expires 7 AM next morning).
INDMONEY_ACCESS_TOKEN=

# The real trading bot (phase 3) also places orders through INDmoney with the credentials above.
# Order placement additionally needs this PC's public IP whitelisted on indstocks.com.

# ---------------- Alerts (optional, paper/live bots) ----------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------- Misc ----------------
LOG_LEVEL=INFO
