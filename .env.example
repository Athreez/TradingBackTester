# Copy to `.env` (git-ignored) and fill in: the one settings file for the downloader, backtester and bots.
# NEVER commit the real .env. Paste values right after `=`, no quotes.

# ---- INDmoney login: TOTP auto-login, tokens are generated on demand and cached in .secrets/ ----
# Client ID from the indstocks.com Access Tokens page.
INDMONEY_CLIENT_ID=
# Your INDstocks MPIN.
INDMONEY_MPIN=
# The base32 KEY shown once during TOTP setup (the text behind the QR code), not the 6-digit code.
INDMONEY_TOTP_SECRET=

# ---- Paper bot (python -m paper_trader.runner) ----
STRATEGY=vix_iron_fly
CAPITAL=500000
# mirror = also send every order to INDmoney for real. Only for an EMPTY account: nothing is sent if
# INDmoney reports more than LIVE_MAX_BALANCE rupees available. Needs this PC's static IP registered.
LIVE_ORDERS=off
LIVE_MAX_BALANCE=100

# ---- Telegram (optional): token from @BotFather, chat id from `python -m paper_trader.notify chat-id` ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

LOG_LEVEL=INFO
