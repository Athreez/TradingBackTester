# Copy to paper_trader/.env (git-ignored). Credentials stay in the root .env.
STRATEGY=vix_iron_fly
CAPITAL=500000
# mirror = also send every order to INDmoney for real (live_trader/mirror.py). Only for an EMPTY account:
# nothing is sent if INDmoney reports more than LIVE_MAX_BALANCE rupees available. Needs the static IP.
LIVE_ORDERS=off
LIVE_MAX_BALANCE=100
