# ---- SECRETS: never commit these ----
.env
*.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
secrets/
.secrets/
token*.json
*_token.json
*.token

# ---- Data & outputs (large / regenerable) ----
data/cache/*
!data/cache/.gitkeep
reports/*
!reports/.gitkeep
*.parquet
*.log

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# ---- Editors / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Paper / live bot runtime output ----
paper_trader/logs/
paper_trader/state/
live_trader/logs/
live_trader/state/
